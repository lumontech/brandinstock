# Copia in deploy/.env sul server:  cp .env.production.example .env && chmod 600 .env
# Genera ogni segreto con:  openssl rand -base64 32   (APP_KEY: vedi README-deploy.md)
#
# ⚠️  APP_KEY e CRM_BLIND_INDEX_KEY cifrano/indicizzano i dati del CRM: se li perdi,
#     i dati cifrati NON sono recuperabili. Conservane una copia offline (password manager).

APP_DOMAIN=crm.brandinstock.it
# Solo se la VPS ha già un server web su 80/443 (impostato da install.sh):
# HTTP_BIND=127.0.0.1:8088
# HTTPS_BIND=127.0.0.1:8443
# CADDY_SITE_ADDRESS=http://crm.brandinstock.it
ACME_EMAIL=info@brandinstock.it

APP_KEY=
# In caso di rotazione della chiave: la vecchia va qui (separate da virgola)
APP_PREVIOUS_KEYS=
CRM_BLIND_INDEX_KEY=

DB_DATABASE=brandinstock_crm
# Superutente PostgreSQL: usato solo da PostgreSQL stesso e dai backup
POSTGRES_PASSWORD=
# Proprietario dello schema: solo per le migration
DB_MIGRATION_USERNAME=crm_owner
DB_MIGRATION_PASSWORD=
# Utente applicativo: solo lettura/scrittura dati
DB_USERNAME=crm_app
DB_PASSWORD=

CRM_REQUIRE_2FA_ROLES=admin,manager

# Backup cifrati (chiave pubblica age, la privata resta OFFLINE)
BACKUP_AGE_RECIPIENT=
BACKUP_DIR=/var/backups/brandinstock-crm
BACKUP_RETENTION_DAYS=30
# Opzionale: copia off-site con rclone (es. Contabo Object Storage), es. "contabo:brandinstock-backups"
BACKUP_RCLONE_REMOTE=
